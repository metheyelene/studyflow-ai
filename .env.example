# ── StudyFlow AI environment variables ─────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to git. Secrets live only in .env (local) or your
# hosting provider's secret store (Vercel / GitHub Actions).
# Full reference: docs/environment-variables.md

# ── Database (Neon Postgres) ────────────────────────────────────────
# Create a free Neon account at https://neon.tech → new project →
# copy the connection strings. Use the POOLED connection (-pooler) for
# the app, and the DIRECT connection for migrations.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_DIRECT="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# ── Authentication (Better Auth) ────────────────────────────────────
# Generate with:  openssl rand -base64 32
# The secret MUST be identical across environments (dev/prod) or
# sessions break on redeploy.
BETTER_AUTH_SECRET="replace-with-a-long-random-string"
# Local dev: http://localhost:3000 (or the port Next prints).
# Production: your real domain, e.g. https://studyflow.example.com
BETTER_AUTH_URL="http://localhost:3000"
# Extra origins allowed for cookie auth in production, comma-separated
# (e.g. a Flutter web build served from another origin). Native mobile
# apps send no Origin header and don't need this.
# TRUSTED_ORIGINS_EXTRA="https://studyflow-mobile.pages.dev"
# Public origin of the app (used for absolute links / metadata).
# NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Require new users to verify their email before signing in. OFF by
# default (test users sign up instantly); turn ON in production once
# email sending works. Needs an email provider below.
# EMAIL_VERIFICATION_REQUIRED="false"

# ── Email (password reset + verification) ──────────────────────────
# In development, emails are logged to the server console — no provider
# needed. In production, set a Resend API key + verified domain:
#   https://resend.com
# RESEND_API_KEY="re_..."
# EMAIL_FROM="StudyFlow <no-reply@yourdomain.com>"

# ── Google OAuth (optional, one-click signup) ───────────────────────
# Create credentials at https://console.cloud.google.com → APIs &
# Services → Credentials → OAuth client ID (Web application). Authorized
# redirect URI: http://localhost:3000/api/auth/callback/google (dev) and
# https://your-domain.com/api/auth/callback/google (prod).
# GOOGLE_CLIENT_ID="1234-abc.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="GOCSPX-..."
# NEXT_PUBLIC_GOOGLE_CLIENT_ID="1234-abc.apps.googleusercontent.com"

# ── AI provider orchestration (source-grounded engine) ──────────────
# The app is provider-agnostic via src/lib/ai/orchestrator.ts. Get keys:
#   OpenAI:    https://platform.openai.com/api-keys
#   Anthropic: https://console.anthropic.com/settings/keys
# Failover order: the first provider WITH a key is used; on failure the
# next in the list is tried. Default: "openai,anthropic".
AI_PROVIDER_ORDER="openai,anthropic"
OPENAI_API_KEY="sk-..."
# ANTHROPIC_API_KEY="sk-ant-..."
# Per-tier model overrides (optional — defaults live in orchestrator.ts).
# Tiers: simple (title/tag/extract), standard (summaries, flashcards,
# quizzes, chat), complex (comparisons, study planning).
# AI_MODEL_SIMPLE="gpt-4o-mini"
# AI_MODEL_STANDARD="gpt-4o-mini"
# AI_MODEL_COMPLEX="gpt-4o"

# ── Payments (Stripe) — founding-member offer ───────────────────────
# Secret key from the Stripe dashboard (test mode first).
# STRIPE_SECRET_KEY="sk_test_..."
# Webhook signing secret (Stripe → Webhooks → endpoint → signing secret).
# STRIPE_WEBHOOK_SECRET="whsec_..."
# Price ID of the recurring $2/month founding-member price (product:
# "StudyFlow Premium — Founding Member").
# STRIPE_FOUNDING_PRICE_ID="price_..."
# Canonical app origin used in checkout success/cancel redirects.
# APP_URL="https://studyflow.example.com"
# Comma-separated emails allowed to view /admin (founding-member stats).
# ADMIN_EMAILS="you@example.com"

# ── File storage (Cloudflare R2) — added in the notes phase ─────────
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME="studyflow-documents"

# ── Rate limiting (Upstash Redis) — added in a later phase ──────────
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# ── Error tracking (Sentry) — added in a later phase ────────────────
# SENTRY_DSN=""
