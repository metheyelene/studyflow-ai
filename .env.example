# ── StudyFlow AI environment variables ─────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to git. Secrets live only in .env (local) or your
# hosting provider's secret store (Vercel / GitHub Actions).
# Full reference: docs/environment-variables.md

# ── Database (Neon Postgres) ────────────────────────────────────────
# Create a free Neon account at https://neon.tech → new project →
# copy the connection strings. Use the POOLED connection (-pooler) for
# the app, and the DIRECT connection for migrations.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_DIRECT="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# ── Authentication (Better Auth) ────────────────────────────────────
# Generate with:  openssl rand -base64 32
# The secret MUST be identical across environments (dev/prod) or
# sessions break on redeploy.
BETTER_AUTH_SECRET="replace-with-a-long-random-string"
# Local dev: http://localhost:3000 (or the port Next prints).
# Production: your real domain, e.g. https://studyflow.example.com
BETTER_AUTH_URL="http://localhost:3000"
# Public origin of the app (used for absolute links / metadata).
# NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── AI provider (choose one for now) ────────────────────────────────
# The app is provider-agnostic via src/lib/ai/provider.ts. Set the
# provider and its key. Get keys at:
#   OpenAI:    https://platform.openai.com/api-keys
#   Anthropic: https://console.anthropic.com/settings/keys
AI_PROVIDER="openai"          # "openai" | "anthropic" | (add more in src/lib/ai/provider.ts)
OPENAI_API_KEY="sk-..."
# ANTHROPIC_API_KEY="sk-ant-..."

# ── Payments (Stripe) — added in the payments phase ─────────────────
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# NEXT_PUBLIC_STRIPE_PRICE_MONTHLY="price_..."
# NEXT_PUBLIC_STRIPE_PRICE_YEARLY="price_..."

# ── File storage (Cloudflare R2) — added in the notes phase ─────────
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME="studyflow-documents"

# ── Rate limiting (Upstash Redis) — added in a later phase ──────────
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# ── Error tracking (Sentry) — added in a later phase ────────────────
# SENTRY_DSN=""
